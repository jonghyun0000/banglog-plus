# 기본은 외부 호출 없는 로컬 데모입니다.
AI_MODE=mock
REPOSITORY=memory
PORT=8787
HOST=127.0.0.1
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# 서버 전용 비밀정보. 값은 직접 설정하세요. 브라우저 VITE_ 변수에 넣지 마세요.
OPENAI_API_KEY=
OPENAI_MODEL=
DATABASE_URL=
# 원격 DB TLS는 검증을 끄지 않습니다. 로컬에만 disable 허용.
DATABASE_SSL=require
INTERNAL_LIVE_ENABLED=false
PROVIDER_RETENTION_ACK=false
PUBLIC_LAUNCH_ENABLED=false
MAX_DAILY_CALLS=30
MAX_DAILY_TOKENS=300000
MAX_CONCURRENT=2
MAX_OUTPUT_TOKENS=1800
# 두 단가와 예산을 모두 설정해야 비용 제한 사용. 단위 USD / 1M tokens.
INPUT_USD_PER_MILLION=
OUTPUT_USD_PER_MILLION=
DAILY_BUDGET_USD=
# 다른 API 호스트로 웹을 빌드할 때만 HTTPS origin 지정 (비밀정보 아님)
VITE_API_BASE_URL=

# 선택 로그인: publishable key만 허용합니다. service_role 키를 넣지 마세요.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
MEMBER_HISTORY_ENABLED=false
GOOGLE_LOGIN_ENABLED=false
KAKAO_LOGIN_ENABLED=false

# 배포 웹에서 실제 서버 API를 사용할 때만 true. 기본 hosted 빌드는 브라우저 데모입니다.
VITE_CONNECTED_MODE=false

# GPT 요청 지연/오류/근거 부족 시 명시적인 기본 안내로 전환
AI_FALLBACK_ENABLED=true
OPENAI_TIMEOUT_MS=30000

# 운영 관리자: salt:scrypt 해시와 Cron 인증값. 서버 전용입니다.
ADMIN_PASSWORD_HASH=
CRON_SECRET=

# SMTP 실발송 확인 후 신규 가입 화면 활성화
MEMBER_SIGNUP_ENABLED=false

# v1.x team dashboard: anonymous aggregates and curated sources only. v2+ is closed.
PUBLIC_TEAM_DASHBOARD=true

# Server-only public building register API key
BUILDING_API_KEY=

  "chunks": [
    {
      "id": "maintenance-principle",
      "sourceId": "civil-623",
      "sourceVersion": "2026-03-17.checked-2026-10-21",
      "claimId": "maintenance",
      "claim": "임대인은 계약 기간 동안 주택을 사용·수익하는 데 필요한 상태를 유지할 의무가 있다는 일반 원칙이 있어요.",
      "text": "임대인이 목적물을 사용·수익에 필요한 상태로 유지할 의무가 있다는 일반 원칙을 다룬 조문 요약입니다. 고장 원인이나 모든 수리비의 귀속을 이 조문만으로 확정하지 않습니다.",
      "issues": ["mold", "leak", "boiler", "surface", "drain", "fixture"],
      "keywords": ["수리", "고장", "누수", "곰팡이", "보일러", "배수"],
      "observations": []
    },
    {
      "id": "repair-scope",
      "sourceId": "easylaw-repair",
      "sourceVersion": "checked-2026-10-21",
      "claimId": "scope",
      "claim": "수선의무 범위는 사용에 미치는 영향과 수리의 정도, 계약 조건 등을 함께 확인해야 해요.",
      "text": "공식 생활법령의 수선의무 설명을 정리한 자료입니다. 사용·수익에 미치는 영향, 수리 정도, 계약 문구와 실제 원인을 함께 확인합니다. 세입자 설명과 전달받은 점검 의견을 검증된 원인으로 바꾸지 않습니다.",
      "issues": ["mold", "leak", "boiler", "surface", "drain", "fixture"],
      "keywords": ["계약", "특약", "점검", "노후", "원인", "수선"],
      "observations": []
    },
    {
      "id": "initial-state-restoration",
      "sourceId": "2023da249661",
      "sourceVersion": "checked-2026-11-03",
      "claimId": "initial-state",
      "claim": "입주 당시 상태와 원상회복 약정을 확인할 필요가 있어요. 참고 판결은 이전 임차인의 시설이 있던 토지 사건으로, 주택 벽지·장판 비용을 직접 정한 판결은 아니에요.",
      "text": "2023다249661은 토지 임대 당시 이미 있던 종전 임차인의 시설 철거가 쟁점입니다. 임차 당시 상태로 반환하는 것이 원칙이나 계약 체결 경위와 내용 등 특별한 사정을 개별적으로 판단합니다. 통상 마모 금액이나 벽지 교체비 비율을 정한 판결은 아닙니다.",
      "issues": ["surface"],
      "keywords": ["벽지", "장판", "찍힘", "찢어", "원상회복", "입주"],
      "observations": ["wall-tear", "wall-dent", "floor-tear", "floor-dent"]
    },
    {
      "id": "equipment-cause-and-control",
      "sourceId": "2018da291347",
      "sourceVersion": "checked-2026-11-03",
      "claimId": "equipment-cause",
      "claim": "제품 고장의 원인과 관리 영역을 확인해야 해요. 참고 판결은 임대 장비 반환 시 훼손 사건으로, 임대인의 수선의무만으로 최종 손해배상책임을 정하지 않아요.",
      "text": "2018다291347은 임대 장비의 반환 시 훼손과 손해배상 사건입니다. 임차인이 책임질 수 없는 사유의 증명 및 임대인의 지배·관리 영역에 있는 하자 여부를 심리해야 한다는 취지입니다. 원인 불명만으로 임차인이 면책되는 것은 아니며 주택 옵션 가전의 직접 사건도 아닙니다.",
      "issues": ["fixture", "boiler"],
      "keywords": [
        "냉장고",
        "세탁기",
        "에어컨",
        "보일러",
        "옵션",
        "노후",
        "과실"
      ],
      "observations": []
    }
  ]
